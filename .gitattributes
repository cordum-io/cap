# Shell scripts run inside the pinned Linux codegen container from a bind-mounted
# working tree. With core.autocrlf=true a Windows checkout would give them CRLF
# and the kernel would look for the interpreter "/usr/bin/env bash\r", so the
# container ENTRYPOINT must stay LF on every platform.
*.sh text eol=lf

# Generated exactly from pinned protobuf plugins; keep review and whitespace
# tooling focused on authored source while retaining normal textual diffs.
/cordum/agent/v1/*.pb.go linguist-generated=true whitespace=-trailing-space
/cpp/cordum/agent/v1/*.pb.cc linguist-generated=true whitespace=-trailing-space
/cpp/cordum/agent/v1/*.pb.h linguist-generated=true whitespace=-trailing-space
/node/cap_pb.* linguist-generated=true whitespace=-trailing-space
/node/cordum/agent/v1/*_pb.* linguist-generated=true whitespace=-trailing-space
/python/cordum/agent/v1/*_pb2*.py linguist-generated=true whitespace=-trailing-space
/sdk/python/cap/pb/cordum/agent/v1/*_pb2*.py linguist-generated=true whitespace=-trailing-space
/sdk/ruby/proto/cordum/agent/v1/*_pb.rb linguist-generated=true whitespace=-trailing-space

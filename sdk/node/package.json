{
  "name": "cap-sdk-node",
  "version": "2.17.1-dev",
  "description": "CAP (Cordum Agent Protocol) SDK for Node/TypeScript",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "!dist/sample-worker.*",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cordum-io/cap.git",
    "directory": "sdk/node"
  },
  "homepage": "https://github.com/cordum-io/cap#readme",
  "bugs": {
    "url": "https://github.com/cordum-io/cap/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cap",
    "cordum",
    "agent",
    "protocol",
    "sdk",
    "ai"
  ],
  "scripts": {
    "build": "node scripts/build-package.cjs",
    "lint": "npm run lint:package",
    "lint:package": "publint --pack false --level error",
    "sample:worker": "node dist/sample-worker.js",
    "test": "node -e \"require('fs').rmSync('.build',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && mocha \".build/test/*.test.js\"",
    "test:nats": "node -e \"require('fs').rmSync('.build',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && mocha \".build/test/integration/*.e2e.js\"",
    "test:package": "node scripts/verify-package.cjs",
    "docs": "typedoc --out docs src/index.ts"
  },
  "dependencies": {
    "nats": "^2.16.0",
    "protobufjs": "^7.2.5",
    "redis": "^4.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/chai": "4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "18.19.130",
    "chai": "4.5.0",
    "mocha": "^11.7.5",
    "publint": "0.3.21",
    "ts-mocha": "^11.1.0",
    "tsconfig-paths": "^4.2.0",
    "typedoc": "^0.28.17",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "diff": "^8.0.3"
  }
}

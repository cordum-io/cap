{
  "schema_version": 1,
  "spec": "spec/interop/cloudevents-mapping.md",
  "description": "CloudEvents 1.0 mapping vectors for CAP job progress, job result, alert and workflow-event packets. Each case gives the NATS subject, the admission mode, the received headers and an admitted packet in proto3 JSON, and the CloudEvent a conforming mapper produces. Mapping starts after admission or validation, so these are not signing or admission vectors. Every id, time, data and extension value was derived by a reference mapper, and every legacy id was recomputed with two independent RFC 8785 implementations.",
  "sources": {
    "cloudevents_spec": "https://github.com/cloudevents/spec/blob/v1.0.2/cloudevents/spec.md",
    "cloudevents_json_format": "https://github.com/cloudevents/spec/blob/v1.0.2/cloudevents/formats/json-format.md",
    "cloudevents_distributed_tracing": "https://github.com/cloudevents/spec/blob/v1.0.2/cloudevents/extensions/distributed-tracing.md",
    "jcs": "RFC 8785 (JSON Canonicalization Scheme)",
    "proto3_json": "https://protobuf.dev/programming-guides/json/",
    "trace_context_vectors": "spec/interop/vectors/trace-context-v1.json",
    "verified_with": {
      "protobuf": "protobuf (python) 6.33.6 json_format, CAP python stubs from CAP commit 85097a10b8b77876107e0a2569b271dfa2fd6c98",
      "rfc8785": "rfc8785 (python) 0.1.4",
      "canonicalize": "canonicalize (npm) 2.1.0"
    }
  },
  "mapper_config": {
    "source": "https://cap.example/clusters/dev"
  },
  "redacted_keys": [
    "auth_token",
    "authToken",
    "signature",
    "signature_metadata",
    "signatureMetadata",
    "identity",
    "env",
    "labels",
    "error_message",
    "errorMessage"
  ],
  "cases": [

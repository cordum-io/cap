    {
      "behavior": "signature validity (invalid/missing/expired/wrong-audience)",
      "gated": "cap-production",
      "reason": "signing/verification and the audience model are owned by task-a13f83fa (CAP-PRODUCTION), now merged; cross-SDK signature verification ships in the DoD-2 matrix, but expiry/wrong-audience rejection semantics are that task's conformance surface, not this one's",
      "cases": []
    },
    {
      "behavior": "identity/attempt/resource mismatch rejection",
      "gated": "cap-production",
      "reason": "DispatchIdentity attempt/resource fields from task-a13f83fa are merged and this TCK consumes them for duplicate/retry fencing; standalone identity/resource mismatch rejection remains that task's conformance surface",
      "cases": []
    },
    {
      "behavior": "session mismatch and dispatch-before-authenticated-acceptance rejection",
      "gated": "handshake",
      "reason": "the authenticated worker handshake/session from task-a4b71af is merged (PR #69); session-binding rejection is the handshake profile's own conformance surface and is not part of this task's core-profile scope",
      "cases": []
    },
    {
      "behavior": "stale policy/content/snapshot cache reuse rejection",
      "gated": "cap-production",
      "reason": "the CAP-PRODUCTION policy snapshot model is merged, but it defines snapshot identity rather than a wire-observable staleness bound, so cache-reuse rejection is not yet expressible as an adapter-v1 conformance case",
      "cases": []
    },
    {
      "behavior": "exact-redelivery duplicate suppression",
      "cases": [
        "duplicates/worker-exact-redelivery-invokes-handler-once",
        "duplicates/worker-exact-redelivery-replays-idempotent-result",
        "duplicates/cp-duplicate-result-applies-once",
        "duplicates/worker-distinct-dispatch-is-not-suppressed"
      ]
    },
    {
      "behavior": "retry attempt fencing (monotonic attempt, stale/future/wrong-worker rejection)",
      "cases": [
        "retries/worker-new-attempt-invokes-once",
        "retries/worker-rejects-stale-attempt",
        "retries/worker-rejects-future-attempt",
        "retries/worker-rejects-wrong-worker-attempt",
        "retries/cp-ignores-stale-attempt-result",
        "retries/cp-ignores-stale-attempt-progress"
      ]
    },
    {
      "behavior": "cancel-vs-result race, exactly one winner",
      "gated": "cap-production",
      "reason": "deterministic cancellation is covered ungated above (cancellation from any non-terminal state; cancellation after terminal rejected); the concurrent cancel-vs-result race needs a scheduler-level interleaving harness beyond this TCK's request/response adapter contract",
      "cases": []
    }
  ]
}

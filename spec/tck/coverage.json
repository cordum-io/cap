      "spec": "spec/07-state-machine.md#L47",
      "cases": ["lifecycle/worker-same-state-idempotent"]
    },
    {
      "behavior": "backwards transition rejected",
      "spec": "spec/07-state-machine.md#L48",
      "cases": [
        "lifecycle/worker-rejects-backwards-transition",
        "lifecycle/cp-rejects-backwards-transition"
      ]
    },
    {
      "behavior": "second conflicting terminal ignored",
      "spec": "spec/07-state-machine.md#L49",
      "cases": ["lifecycle/worker-rejects-second-terminal"]
    },
    {
      "behavior": "every terminal status reachable",
      "spec": "spec/07-state-machine.md",
      "cases": [
        "lifecycle/worker-running-to-succeeded",
        "lifecycle/worker-running-to-failed",
        "lifecycle/worker-running-to-failed-fatal",
        "lifecycle/cp-scheduled-to-denied",
        "lifecycle/cp-dispatched-to-timeout",
        "cancellation/cp-cancel-from-running"
      ]
    },
    {
      "behavior": "cancellation from any non-terminal state",
      "spec": "spec/07-state-machine.md#L50",
      "cases": [
        "cancellation/cp-cancel-from-pending",
        "cancellation/cp-cancel-from-running",
        "cancellation/worker-honors-cancel"
      ]
    },
    {
      "behavior": "cancellation after terminal rejected",
      "spec": "spec/07-state-machine.md#L50",
      "cases": ["cancellation/cp-rejects-cancel-after-terminal"]
    },
    {

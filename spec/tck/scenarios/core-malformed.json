      "profile": "core",
      "required": true,
      "params": {"expect": "drop", "err": "ERROR_CODE_PROTOCOL_MALFORMED_PACKET", "spec": "job.proto#ERROR_CODE_PROTOCOL_MALFORMED_PACKET"}
    },
    {
      "id": "malformed/overlong-wire",

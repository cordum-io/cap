{
  "version": 1,
  "scenarios": [
    {
      "id": "retries/worker-new-attempt-invokes-once",
      "title": "a new monotonically increasing attempt invokes the handler exactly once",
      "role": "worker",
      "profile": "cap-production",
      "required": true,
      "params": {
        "dispatchId": "dsp-1",
        "event": "dispatch",
        "attempt": "2",
        "activeAttempt": "1",
        "assignedWorkerId": "wrk-1",
        "expect": "invoke",
        "spec": "job.proto#DispatchIdentity"
      }
    },
    {
      "id": "retries/worker-rejects-stale-attempt",
      "title": "a stale (lower) attempt must not mutate the active attempt",
      "role": "worker",
      "profile": "cap-production",
      "required": true,
      "params": {
        "dispatchId": "dsp-1",
        "event": "dispatch",
        "attempt": "1",
        "activeAttempt": "2",
        "assignedWorkerId": "wrk-1",
        "expect": "reject",
        "spec": "job.proto#DispatchIdentity"
      }
    },
    {
      "id": "retries/worker-rejects-future-attempt",
      "title": "a future attempt that skips the issued sequence is rejected",
      "role": "worker",
      "profile": "cap-production",
      "required": true,
      "params": {
        "dispatchId": "dsp-1",
        "event": "dispatch",
        "attempt": "9",
        "activeAttempt": "2",
        "assignedWorkerId": "wrk-1",
        "expect": "reject",
        "spec": "job.proto#DispatchIdentity"
      }
    },
    {
      "id": "retries/worker-rejects-wrong-worker-attempt",
      "title": "a dispatch addressed to a different assigned_worker_id is rejected even when its attempt is otherwise valid",
      "role": "worker",
      "profile": "cap-production",
      "required": true,
      "params": {
        "dispatchId": "dsp-1",
        "event": "dispatch",
        "attempt": "3",
        "activeAttempt": "2",
        "assignedWorkerId": "wrk-other",
        "expect": "reject",
        "spec": "job.proto#DispatchIdentity"
      }
    },
    {
      "id": "retries/worker-honors-active-cancel",
      "title": "a JobCancel targeting the active attempt stops that attempt",
      "role": "worker",
      "profile": "cap-production",
      "required": true,
      "params": {
        "dispatchId": "dsp-1",
        "event": "cancel",
        "attempt": "2",
        "activeAttempt": "2",
        "assignedWorkerId": "wrk-1",
        "expect": "cancel",
        "spec": "buspacket.proto#JobCancel"
      }
    },
    {
      "id": "retries/worker-rejects-stale-cancel",
      "title": "a JobCancel carrying a stale attempt must not tear down the active attempt",
      "role": "worker",
      "profile": "cap-production",
      "required": true,
      "params": {
        "dispatchId": "dsp-1",
        "event": "cancel",
        "attempt": "1",
        "activeAttempt": "2",
        "assignedWorkerId": "wrk-1",
        "expect": "reject",
        "spec": "buspacket.proto#JobCancel"
      }
    },
    {
      "id": "retries/worker-rejects-wrong-worker-cancel",
      "title": "a JobCancel addressed to a different assigned_worker_id must not cancel our attempt",
      "role": "worker",
      "profile": "cap-production",
      "required": true,
      "params": {
        "dispatchId": "dsp-1",
        "event": "cancel",
        "attempt": "2",
        "activeAttempt": "2",
        "assignedWorkerId": "wrk-other",
        "expect": "reject",
        "spec": "buspacket.proto#JobCancel"
      }
    },
    {
      "id": "retries/cp-ignores-stale-attempt-result",
      "title": "control plane ignores a JobResult carrying a stale attempt",
      "role": "control-plane",
      "profile": "cap-production",
      "required": true,
      "params": {
        "dispatchId": "dsp-1",
        "event": "result",
        "attempt": "1",
        "activeAttempt": "2",
        "expect": "ignore",
        "spec": "job.proto#DispatchIdentity"
      }
    },
    {
      "id": "retries/cp-ignores-stale-attempt-progress",
      "title": "control plane ignores JobProgress carrying a stale attempt",
      "role": "control-plane",
      "profile": "cap-production",
      "required": true,
      "params": {
        "dispatchId": "dsp-1",
        "event": "progress",
        "attempt": "1",
        "activeAttempt": "2",
        "expect": "ignore",
        "spec": "job.proto#DispatchIdentity"
      }
    },
    {
      "id": "retries/cp-ignores-stale-attempt-cancel",
      "title": "control plane ignores a JobCancel carrying a stale attempt",
      "role": "control-plane",
      "profile": "cap-production",
      "required": true,
      "params": {
        "dispatchId": "dsp-1",
        "event": "cancel",
        "attempt": "1",
        "activeAttempt": "2",
        "expect": "ignore",
        "spec": "buspacket.proto#JobCancel"
      }
    }
  ]
}

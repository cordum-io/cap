# Hermetic code-generation image for every checked-in CAP protobuf artifact.
#
# CONTRACT
# --------
# This image contains every generator the tracked tree needs, at the exact
# version that produced it, so that `docker run --network=none` can regenerate
# all 74 manifest outputs and prove they are byte-identical to what is checked
# in. Generation runs the canonical generator (tools/proto_codegen.py) in its
# --offline mode, which swaps //buf.gen.yaml's buf.build REMOTE plugins for the
# version-matched LOCAL plugins installed below. buf emits identical bytes for a
# remote and a local plugin at the same version, so the offline path is a
# mirror of the online one rather than a competing second generator.
#
# Every version here is locked to //buf.gen.yaml, //tools/codegen/package.json
# and //sdk/python/requirements-codegen.txt. tools/codegen/template_test.go
# (TestOfflineTemplateMirrorsRemoteTemplate) fails if they drift apart.
#
# NOTE ON THE BASE DIGEST: CI resolves and pins it via
#   docker buildx build --pull && docker image inspect --format '{{index .RepoDigests 0}}'
FROM golang:1.25.12-bookworm

# Locked to //buf.gen.yaml. cpp/js are generated by protoc 21.12 (the last
# release whose bundled JS generator matches protobuf-javascript 3.21.4); ruby
# by protoc 33.2. They are NOT interchangeable -- each language's tracked bytes
# came from its own protoc.
ARG PROTOC_CPP_JS_VERSION=21.12
ARG PROTOC_RUBY_VERSION=33.2
ARG BUF_VERSION=v1.71.0
ARG PROTOC_GEN_GO_VERSION=v1.36.11
ARG PROTOC_GEN_GO_GRPC_VERSION=v1.6.0
ARG NODE_MAJOR=20

ENV TZ=UTC \
    LC_ALL=C.UTF-8 \
    SOURCE_DATE_EPOCH=1700000000 \
    DEBIAN_FRONTEND=noninteractive

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends unzip python3 python3-pip ca-certificates; \
    rm -rf /var/lib/apt/lists/*

# protoc distributions. buf drives these through `protoc_builtin:` so that the
# FileDescriptorProto handed to each generator carries the json_name fields buf
# populates; invoking protoc directly changes the C++ comments and the
# serialized Ruby descriptor.
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) protoc_arch=linux-x86_64 ;; \
      arm64) protoc_arch=linux-aarch_64 ;; \
      *) echo "unsupported arch: $arch" >&2; exit 1 ;; \
    esac; \
    for version in "${PROTOC_CPP_JS_VERSION}" "${PROTOC_RUBY_VERSION}"; do \
      curl -fsSL -o /tmp/protoc.zip \
        "https://github.com/protocolbuffers/protobuf/releases/download/v${version}/protoc-${version}-${protoc_arch}.zip"; \
      mkdir -p "/opt/protoc-${version}"; \
      unzip -q /tmp/protoc.zip -d "/opt/protoc-${version}"; \
      rm /tmp/protoc.zip; \
      "/opt/protoc-${version}/bin/protoc" --version; \
    done

# Go plugins and buf itself, pinned by version and installed as binaries so the
# offline run never needs the module proxy.
RUN set -eux; \
    go install "google.golang.org/protobuf/cmd/protoc-gen-go@${PROTOC_GEN_GO_VERSION}"; \
    go install "google.golang.org/grpc/cmd/protoc-gen-go-grpc@${PROTOC_GEN_GO_GRPC_VERSION}"; \
    go install "github.com/bufbuild/buf/cmd/buf@${BUF_VERSION}"

# Node toolchain for the two JS surfaces:
#   * ts-protoc-gen  -> node/cordum/agent/v1/*_pb.d.ts   (buf local plugin)
#   * protobufjs-cli -> node/cap_pb.{js,d.ts}            (pbjs/pbts bundle)
# node_modules is baked in at a fixed path; the offline run must not npm ci.
RUN set -eux; \
    curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | bash -; \
    apt-get install -y --no-install-recommends nodejs; \
    rm -rf /var/lib/apt/lists/*; \
    node --version
COPY tools/codegen/package.json tools/codegen/package-lock.json /opt/codegen-node/
RUN set -eux; \
    cd /opt/codegen-node; \
    npm ci --ignore-scripts --no-audit --no-fund

# protoc-gen-js. The npm `google-protobuf` package ships the runtime only; the
# generator binary lives in the separate protobuf-javascript release.
ARG PROTOC_GEN_JS_VERSION=3.21.4
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) js_arch=linux-x86_64 ;; \
      arm64) js_arch=linux-aarch_64 ;; \
      *) echo "unsupported arch: $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/js.zip \
      "https://github.com/protocolbuffers/protobuf-javascript/releases/download/v${PROTOC_GEN_JS_VERSION}/protobuf-javascript-${PROTOC_GEN_JS_VERSION}-${js_arch}.zip"; \
    unzip -q /tmp/js.zip -d /opt/protobuf-javascript; \
    rm /tmp/js.zip; \
    install -m 0755 /opt/protobuf-javascript/bin/protoc-gen-js /usr/local/bin/protoc-gen-js

# Python generator. Installed from the canonical requirements file rather than
# a copy of the pins, so the image cannot drift from what
# tools/python_proto_codegen.py enforces at run time. Installing
# `grpcio-tools==1.76.0` alone is NOT enough: its `grpcio>=1.76.0` dependency
# resolves to a newer grpcio and validate_python_pins fails closed on it.
COPY sdk/python/requirements-codegen.txt /opt/codegen-python/requirements.txt
RUN pip3 install --no-cache-dir --break-system-packages -r /opt/codegen-python/requirements.txt

ENV PATH="/root/go/bin:${PATH}" \
    CAP_CODEGEN_NODE_MODULES=/opt/codegen-node/node_modules \
    CAP_CODEGEN_PROTOC_CPP=/opt/protoc-21.12/bin/protoc \
    CAP_CODEGEN_PROTOC_RUBY=/opt/protoc-33.2/bin/protoc
WORKDIR /src
ENTRYPOINT ["/src/tools/codegen/generate.sh"]
